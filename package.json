{
  "name": "instant-tex",
  "version": "0.6.1",
  "description": "Local-first LaTeX scratchpad with instant math preview",
  "author": "Instant TeX",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.*",
    "test:desktop": "npm run build && node tests/desktop.mjs",
    "package": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "computer-modern": "^0.1.3",
    "dompurify": "^3.4.16",
    "eventsource-parser": "^4.1.1",
    "katex": "^0.16.22",
    "lucide": "^1.51.0",
    "markdown-it": "^15.0.2",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.55.0",
    "vite": "^7.1.0"
  },
  "build": {
    "compression": "store",
    "appId": "local.instanttex.scratchpad",
    "productName": "Instant TeX",
    "directories": {
      "output": "release-v7"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "assets/icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "icon": "assets/icon.icns"
    },
    "portable": {
      "artifactName": "Instant-TeX-${version}-Windows.exe"
    }
  }
}
